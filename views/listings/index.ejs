

<% layout("/layouts/boilerplate") -%>

<div class="d-flex align-items-center justify-content-between border-bottom my-3 pb-2 flex-wrap gap-2">
    <div class="filters">
        <a href="/listings" class="filter-item <%= !selectedCategory ? 'active' : '' %>">
            <div><i class="fa-solid fa-border-all"></i></div>
            <p>All</p>
        </a>
        <a href="/listings?category=Trending" class="filter-item <%= selectedCategory === 'Trending' ? 'active' : '' %>">
            <div><i class="fa-solid fa-fire"></i></div>
            <p>Trending</p>
        </a>
        <a href="/listings?category=Hotel" class="filter-item <%= selectedCategory === 'Hotel' ? 'active' : '' %>">
            <div><i class="fa-solid fa-hotel"></i></div>
            <p>Hotel</p>
        </a>
        <a href="/listings?category=Camping" class="filter-item <%= selectedCategory === 'Camping' ? 'active' : '' %>">
            <div><i class="fa-solid fa-campground"></i></div>
            <p>Camping</p>
        </a>
        <a href="/listings?category=City" class="filter-item <%= selectedCategory === 'City' ? 'active' : '' %>">
            <div><i class="fa-solid fa-city"></i></div>
            <p>City</p>
        </a>
        <a href="/listings?category=Ship" class="filter-item <%= selectedCategory === 'Ship' ? 'active' : '' %>">
            <div><i class="fa-solid fa-ship"></i></div>
            <p>Ship</p>
        </a>
        <a href="/listings?category=Forest" class="filter-item <%= selectedCategory === 'Forest' ? 'active' : '' %>">
            <div><i class="fa-solid fa-tree"></i></div>
            <p>Forest</p>
        </a>
        <a href="/listings?category=Mountain" class="filter-item <%= selectedCategory === 'Mountain' ? 'active' : '' %>">
            <div><i class="fa-solid fa-mountain"></i></div>
            <p>Mountain</p>
        </a>
        <a href="/listings?category=Cloudy" class="filter-item <%= selectedCategory === 'Cloudy' ? 'active' : '' %>">
            <div><i class="fa-solid fa-cloud-showers-heavy"></i></div>
            <p>Cloudy</p>
        </a>
        <a href="/listings?category=Beach" class="filter-item <%= selectedCategory === 'Beach' ? 'active' : '' %>">
            <div><i class="fa-solid fa-umbrella-beach"></i></div>
            <p>Beach</p>
        </a>
    </div>

    <div class="border rounded-pill px-3 py-1 ms-auto bg-white shadow-sm">
        <div class="form-check form-switch m-0">
            <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
            <label class="form-check-label small" for="switchCheckDefault">Display taxes</label>
        </div>
    </div>
</div>

<% if (searchQuery || selectedCategory) { %>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <p class="mb-0 text-muted">
            <% if (searchQuery) { %>
                <i class="fa-solid fa-magnifying-glass text-theme me-1"></i>Search: <strong class="text-theme">"<%= searchQuery %>"</strong>
            <% } else if (selectedCategory) { %>
                <i class="fa-solid fa-filter text-theme me-1"></i>Category: <strong class="text-theme"><%= selectedCategory %></strong>
            <% } %>
            (<%= alldata.length %> listings found)
        </p>
        <a href="/listings" class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-xmark me-1"></i>Clear</a>
    </div>
<% } %>

<% if (alldata.length === 0) { %>
    <div class="text-center py-5">
        <i class="fa-solid fa-magnifying-glass fa-3x text-muted mb-3 opacity-50"></i>
        <h4 class="text-muted fw-bold">No listings found</h4>
        <p class="text-muted">Try searching for something else or browse all listings.</p>
        <a href="/listings" class="btn btn-theme mt-2"><i class="fa-solid fa-compass me-1"></i>View All Listings</a>
    </div>
<% } else { %>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 mb-4">
        <% for (let listing of alldata) { %>
            <div class="col">
                <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark">
                    <div class="card h-100 shadow-sm listing-card border-0  ">
                        <img 
                            src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=800&q=60' %>" 
                            class="card-img-top  rounded" 
                            alt="<%= listing.title %>">
                        <div class="card-body">
                            <h6 class="card-title fw-bold text-truncate mb-1"><%= listing.title %></h6>
                            <p class="card-text text-muted small mb-2">
                                <i class="fa-solid fa-location-dot text-theme me-1"></i><%= listing.location %>, <%= listing.country %>
                            </p>
                            <p class="card-text mb-0">
                                <b>&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "0" %></b> <span class="text-muted small">/ night</span>
                                <i class="tax-info text-muted small ms-1" style="display: none;">+18% GST</i>
                            </p>
                        </div>
                    </div>
                </a>
            </div>
        <% } %>
    </div>
<% } %>

<script>
    const taxSwitch = document.getElementById("switchCheckDefault");
    if (taxSwitch) {
        taxSwitch.addEventListener("click", () => {
            const taxInfos = document.getElementsByClassName("tax-info");
            for (let info of taxInfos) {
                if (taxSwitch.checked) {
                    info.style.display = "inline";
                } else {
                    info.style.display = "none";
                }
            }
        });
    }
</script>