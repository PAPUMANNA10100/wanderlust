<% layout("/layouts/boilerplate") -%>

<div class="row my-4">
    <div class="col-12 col-lg-10 offset-lg-1">
        <h3 class="fw-bold mb-1"><%= listing.title %></h3>
        <p class="text-muted mb-3">
            <i class="fa-solid fa-location-dot text-theme me-1"></i>
            <%= listing.location %>, <%= listing.country %>
            <% if (listing.category) { %>
                <span class="badge bg-theme-subtle text-theme border ms-2"><%= listing.category %></span>
            <% } %>
        </p>

        <img 
            src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=800&q=60' %>" 
            class="img-fluid  rounded p-3 show-img w-100 mb-4 shadow-sm" 
            alt="<%= listing.title %>">

        <div class="row  mb-4">
            <div class="col-12 col-md-8">
                <div class="d-flex align-items-center gap-3 py-3 border-bottom">
                    <div class="avatar-circle bg-danger text-white rounded-circle d-flex align-items-center justify-content-center fw-bold fs-5">
                        <%= listing.owner && listing.owner.username ? listing.owner.username.charAt(0).toUpperCase() : 'H' %>
                    </div>
                    <div>
                        <h6 class="mb-0 fw-bold">Hosted by <%= listing.owner && listing.owner.username ? listing.owner.username : 'StayScape Host' %></h6>
                        <small class="text-muted">Dedicated Host &bull; StayScape Verified</small>
                    </div>
                </div>

                <div class="py-3 border-bottom">
                    <h5 class="fw-bold mb-2">About this place</h5>
                    <p class="text-secondary mb-0" style="white-space: pre-line; line-height: 1.7;">
                        <%= listing.description %>
                    </p>
                </div>

                <% if (currentUser && listing.owner && listing.owner._id.equals(currentUser._id)) { %>
                    <div class="d-flex flex-wrap gap-2 py-3 border-bottom">
                        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark rounded-pill px-4">
                            <i class="fa-solid fa-pen-to-square me-1"></i> Edit Listing
                        </a>
                        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
                            <button class="btn btn-outline-danger rounded-pill px-4" onclick="return confirm('Are you sure you want to delete this listing?')">
                                <i class="fa-solid fa-trash me-1"></i> Delete
                            </button>
                        </form>
                    </div>
                <% } %>
            </div>

            <div class="col-12 col-md-4">
                <div class="card shadow-sm p-4 border rounded-3 sticky-top" style="top: 90px;">
                    <div class="d-flex justify-content-between align-items-baseline mb-3">
                        <h4 class="fw-bold mb-0">
                            &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "0" %>
                            <span class="text-muted fs-6 fw-normal">/ night</span>
                        </h4>
                        <span class="badge bg-light text-dark border">
                            <i class="fa-solid fa-shield-halved text-theme me-1"></i>Verified
                        </span>
                    </div>

                    <div class="border rounded-3 p-3 mb-3 bg-light">
                        <div class="d-flex justify-content-between small text-muted mb-2">
                            <span>Base price (1 night)</span>
                            <span>&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "0" %></span>
                        </div>
                        <div class="d-flex justify-content-between small text-muted mb-2">
                            <span>GST (18%)</span>
                            <span>&#8377; <%= listing.price ? Math.round(listing.price * 0.18).toLocaleString("en-IN") : "0" %></span>
                        </div>
                        <div class="d-flex justify-content-between small text-muted mb-2">
                            <span>StayScape fee</span>
                            <span class="text-success fw-semibold">Free</span>
                        </div>
                        <hr class="my-2">
                        <div class="d-flex justify-content-between fw-bold">
                            <span>Total</span>
                            <span class="text-theme">&#8377; <%= listing.price ? Math.round(listing.price * 1.18).toLocaleString("en-IN") : "0" %></span>
                        </div>
                    </div>

                    <button class="btn btn-theme w-100 rounded-pill py-2 fw-semibold mb-2" onclick="alert('Booking completed tempurary!')">
                        <i class="fa-regular fa-calendar-check me-1"></i> Reserve
                    </button>
                    <p class="text-center text-muted small mb-0"><i>Payment is not required yet</i></p>
                </div>
            </div>
        </div>

        <hr>

        <div class="mb-4">
            <h4 class="mb-3"><i class="fa-solid fa-star text-theme me-2"></i>Reviews</h4>

            <% if (currentUser) { %>
                <div class="card p-3 mb-4 bg-white shadow-sm border-0">
                    <h5 class="card-title fw-bold">Leave a Review</h5>
                    <form action="/listings/<%= listing._id %>/reviews" method="POST" class="needs-validation" novalidate>
                        <div class="mb-3">
                            <label for="rating" class="form-label">Rating: <span id="ratingVal">5</span> / 5</label>
                            <input type="range" min="1" max="5" name="review[rating]" id="rating" class="form-range" value="5" oninput="document.getElementById('ratingVal').innerText = this.value">
                        </div>
                        <div class="mb-3">
                            <label for="comment" class="form-label">Comment</label>
                            <textarea id="comment" name="review[comment]" rows="3" class="form-control" required></textarea>
                            <div class="invalid-feedback">Please enter a review.</div>
                        </div>
                        <button type="submit" class="btn btn-theme"><i class="fa-solid fa-check me-1"></i>Submit</button>
                    </form>
                </div>
            <% } else { %>
                <p><a href="/login" class="text-theme text-decoration-none fw-semibold">Log in</a> to leave a review.</p>
            <% } %>

            <% if (listing.reviews && listing.reviews.length > 0) { %>
                <div class="row g-3">
                    <% for (let review of listing.reviews) { %>
                        <div class="col-12 col-md-6">
                            <div class="card h-100 p-3 shadow-sm border-0">
                                <div class="card-body p-0">
                                    <h6 class="card-title fw-bold"><i class="fa-regular fa-user me-1 text-theme"></i>@<%= review.author && review.author.username ? review.author.username : 'User' %></h6>
                                    <p class="text-warning mb-1">
                                        <% for (let i = 1; i <= 5; i++) { %>
                                            <i class="fa-solid fa-star <%= i <= review.rating ? '' : 'text-muted opacity-25' %>"></i>
                                        <% } %>
                                    </p>
                                    <p class="card-text mb-2"><%= review.comment %></p>
                                </div>
                                <% if (currentUser && review.author && review.author._id.equals(currentUser._id)) { %>
                                    <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="mt-auto">
                                        <button class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash me-1"></i>Delete</button>
                                    </form>
                                <% } %>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } else { %>
                <p class="text-muted">No reviews yet.</p>
            <% } %>
        </div>

        <hr>

        <div class="mb-4">
            <h4 class="mb-2"><i class="fa-solid fa-map-location-dot text-theme me-2"></i>Where you'll be</h4>
            <p class="text-muted"><i class="fa-solid fa-location-dot text-theme me-1"></i><%= listing.location %>, <%= listing.country %></p>
            <div
                id="map"
                class="shadow-sm"
                data-coordinates='<%- JSON.stringify(listing.geometry && listing.geometry.coordinates && listing.geometry.coordinates.length === 2 ? listing.geometry.coordinates : [77.2090, 28.6139]) %>'
                data-location="<%= listing.location %>, <%= listing.country %>"
                data-token="<%= mapToken %>">
            </div>
        </div>
    </div>
</div>

<script src="/js/map.js"></script>
