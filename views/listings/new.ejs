<% layout("/layouts/boilerplate") -%>
<div class="row mt-3">
 <div class=" col-12 col-md-10 offset-md-1 col-lg-8 offset-lg-2 ">
    <form method="post" action="/listings" class="needs-validation"  novalidate enctype="multipart/form-data" >
     <br>
        <h3>Create a Listing..</h3>
        <div class="fr-title mb-3">
             <label for="title" class="form-label">title</b></label>
             <input type="text"  class="form-control" name="listing[title]" placeholder="title_name" required>
             <div class="valid-feedback">
                    nice title!
                </div>
        </div>
        <div class="fr-descrip mb-3">
             <label for="description" class="form-label">description</label>
             <textarea type="text"  class="form-control" name="listing[description]" placeholder="write here" required></textarea>
              <div class="invalid-feedback">
                    Please give short description.
                </div>
        </div>
        <div class="fr-image mb-3">
             <label for="image" class="form-label">image</label>
             <input type="file"  class="form-control" name="listing[image]" placeholder="image link/url" required>
        </div>
        <div class="row g-3">
            <div class="fr-price col-md-4">
                <label for="price" class="form-label">price</label>
                <input  class="form-control" name="listing[price]" placeholder="enter price" required>
                <div class="invalid-feedback">
                       Please enter valid price
                </div>
            </div>
            <div class="fr-country  col-md-8 mb-3">
                 <label for="country" class="form-label">country</label>
                 <input type="text"  class="form-control" name="listing[country]" placeholder="country" required>
                <div class="invalid-feedback">
                    Please enter country name.
                </div>
            </div>
        </div>
        <div class="fr-location  mb-3" > 
            <label for="location" class="form-label">location</label>
            <input type="text"   class="form-control" name="listing[location]" placeholder="location" required>
            <div class="invalid-feedback">
                 Please give location
            </div>
        </div>
        
        <div class="fr-btn mb-3">
             <button class=" btn  btn-danger">Add</button>
        </div>
        <br>    
    </form>
   
</div>
</div>